{
  "name": "win12-online-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript rebuild of the Win12 Online desktop shell",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.34",
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
